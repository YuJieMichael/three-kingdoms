  "shield": {"renderer":"siege-rt-view.js#drawUnit","directions":"continuous radians"},
  "melee": {"renderer":"siege-rt-view.js#drawUnit","directions":"continuous radians"},
  "archer": {"renderer":"siege-rt-view.js#drawUnit","directions":"continuous radians"},
  "effects": {"renderer":"siege-rt-view.js","limit":128},
  "audio": {"renderer":"siege-rt-audio.js","type":"Web Audio triangle oscillator","maxVoices":8}
